[Unit]
Description=DE RPI GPIO Service Ver 1.0
After=systemd-modules-load.service
Documentation=https://droneengage.com
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/pi/drone_engage/de_gpio
ExecStart=/home/pi/drone_engage/de_gpio/de_rpi_gpio -c /home/pi/drone_engage/de_gpio/de_rpi_gpio.config.module.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10

# --- Hardening (moderate) ---
NoNewPrivileges=true
PrivateTmp=true

# --- Future: migrate to dedicated droneengage system user ---
# To run as a dedicated user instead of root:
#   1. sudo useradd -r -s /usr/sbin/nologin droneengage
#   2. sudo usermod -aG gpio,i2c,spi droneengage
#   3. chown -R droneengage:droneengage /home/pi/drone_engage/de_gpio/
# Then uncomment:
# User=droneengage
# Group=droneengage
#
# --- Future: full filesystem hardening ---
# ProtectSystem=strict
# ReadWritePaths=/home/pi/drone_engage/de_gpio/
# RestrictSUIDSGID=true
# ProtectHome=read-only

[Install]
WantedBy=multi-user.target
